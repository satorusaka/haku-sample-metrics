{
  "formatVersion": 1,
  "kind": "http-json",
  "capability": "sensor.number.v1",
  "pollSeconds": 5,
  "mapping": {
    "type": "list",
    "list": [
      "volumes"
    ],
    "key": [
      "id"
    ],
    "label": "Storage",
    "labelField": [
      "label"
    ],
    "value": [
      "availableBytes"
    ],
    "conversion": "bytesToGiB"
  }
}
